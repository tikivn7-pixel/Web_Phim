<file path="Frontend/index.html">
<!doctype html>
<html lang="vi">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>LauPhim - Xem Phim Online</title>

    <!-- Sử dụng đường dẫn tương đối (./) để tương thích tốt với cả Live Server và GitHub Pages -->
    <link rel="stylesheet" href="./style.css" />

    <!-- FontAwesome Icons -->
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"
    />

    <!-- HLS.js Library -->
    <script src="https://cdn.jsdelivr.net/npm/hls.js@latest"></script>

    <!-- Plyr CSS & JS (Thư viện Video Player Chuyên Nghiệp) -->
    <link rel="stylesheet" href="https://cdn.plyr.io/3.7.8/plyr.css" />
    <script src="https://cdn.plyr.io/3.7.8/plyr.polyfilled.js"></script>

    <!-- Tùy chỉnh màu sắc Plyr theo tông Netflix/Đỏ của web -->
    <style>
      :root {
        --plyr-color-main: #e50914; /* Màu chủ đạo đỏ Netflix cho Plyr */
      }
      .plyr {
        border-radius: 8px;
        overflow: hidden;
      }
    </style>
  </head>
  <body>
    <!-- NAVBAR -->
    <nav class="navbar">
      <div class="logo" onclick="switchPage('home')">Lau<span>Phim</span></div>

      <ul class="nav-links">
        <li onclick="switchPage('home')">Trang chủ</li>

        <!-- Mục Thể Loại có Dropdown Menu -->
        <li class="dropdown" id="genre-dropdown">
          <span class="dropdown-toggle"
            >Thể Loại <i class="fa-solid fa-caret-down"></i
          ></span>
          <div class="dropdown-menu">
            <div class="genre-grid">
              <span onclick="filterByGenre('Bí Ẩn')">Bí Ẩn</span>
              <span onclick="filterByGenre('Chiến Tranh')">Chiến Tranh</span>
              <span onclick="filterByGenre('Chính Kịch')">Chính Kịch</span>
              <span onclick="filterByGenre('Cổ Trang')">Cổ Trang</span>
              <span onclick="filterByGenre('Gia Đình')">Gia Đình</span>
              <span onclick="filterByGenre('Hài Hước')">Hài Hước</span>
              <span onclick="filterByGenre('Hành Động')">Hành Động</span>
              <span onclick="filterByGenre('Hình Sự')">Hình Sự</span>
              <span onclick="filterByGenre('Học Đường')">Học Đường</span>
              <span onclick="filterByGenre('Khoa Học')">Khoa Học</span>
              <span onclick="filterByGenre('Kinh Dị')">Kinh Dị</span>
              <span onclick="filterByGenre('Kinh Điển')">Kinh Điển</span>
              <span onclick="filterByGenre('Lịch Sử')">Lịch Sử</span>
              <span onclick="filterByGenre('Phim Ngắn')">Phim Ngắn</span>
              <span onclick="filterByGenre('Phiêu Lưu')">Phiêu Lưu</span>
              <span onclick="filterByGenre('Thần Thoại')">Thần Thoại</span>
              <span onclick="filterByGenre('Thể Thao')">Thể Thao</span>
              <span onclick="filterByGenre('Trẻ Em')">Trẻ Em</span>
              <span onclick="filterByGenre('Tài Liệu')">Tài Liệu</span>
              <span onclick="filterByGenre('Tâm Lý')">Tâm Lý</span>
              <span onclick="filterByGenre('Tình Cảm')">Tình Cảm</span>
              <span onclick="filterByGenre('Viễn Tưởng')">Viễn Tưởng</span>
              <span onclick="filterByGenre('Võ Thuật')">Võ Thuật</span>
              <span onclick="filterByGenre('Âm Nhạc')">Âm Nhạc</span>
              <span onclick="filterByGenre('Anime')">Anime</span>
              <span onclick="filterByGenre('Hàn Quốc')">Hàn Quốc</span>
              <span onclick="filterByGenre('Nhật Bản')">Nhật Bản</span>
              <span onclick="filterByGenre('TVShow')">TVShow</span>
            </div>
          </div>
        </li>

        <li onclick="switchPage('wishlist')">Danh sách của tôi</li>
      </ul>

      <!-- Thanh tìm kiếm -->
      <div class="search-box">
        <input
          type="text"
          id="search-input"
          placeholder="Tìm tên phim, thể loại..."
          onkeydown="handleSearch(event)"
        />
        <button class="search-btn" onclick="executeSearch()">
          <i class="fa-solid fa-magnifying-glass"></i>
        </button>
      </div>
    </nav>

    <!-- TRANG TÌM KIẾM -->
    <section id="page-search" class="page">
      <div class="slider-section">
        <h2>
          Kết Quả Tìm Kiếm:
          <span id="search-keyword" style="color: #e50914"></span>
        </h2>
        <div id="search-container" class="movie-slider" style="flex-wrap: wrap">
          <!-- Phim phù hợp sẽ tự động render vào đây qua script.js -->
        </div>
      </div>
    </section>

    <!-- TRANG CHỦ -->
    <section id="page-home" class="page active">
      <!-- HERO BANNER -->
      <div class="hero-banner" id="hero-banner">
        <div class="hero-overlay"></div>
        <div class="hero-content">
          <span class="badge">Phim Nổi Bật</span>
          <h1 id="hero-title">Đang tải...</h1>
          <p id="hero-desc">Đang cập nhật nội dung phim...</p>
          <div class="hero-buttons">
            <button class="btn btn-primary" id="hero-play-btn">
              <i class="fa-solid fa-play"></i> Xem ngay
            </button>
            <button class="btn btn-secondary" id="hero-info-btn">
              <i class="fa-solid fa-circle-info"></i> Thông tin
            </button>
          </div>
        </div>
      </div>

      <!-- MỤC TIẾP TỤC XEM (CONTINUE WATCHING) -->
      <div
        class="slider-section"
        id="continue-watching-section"
        style="display: none"
      >
        <h2>Danh sách Tiếp tục xem</h2>
        <div class="movie-slider" id="continue-watching-slider">
          <!-- Phim đang xem dở sẽ tự động render vào đây qua script.js -->
        </div>
      </div>

      <!-- SLIDER PHIM MỚI -->
      <div class="slider-section">
        <h2>Phim Mới Cập Nhật</h2>
        <button class="slider-btn prev-btn">
          <i class="fa-solid fa-chevron-left"></i>
        </button>
        <div class="movie-slider" id="home-movie-slider"></div>
        <button class="slider-btn next-btn">
          <i class="fa-solid fa-chevron-right"></i>
        </button>
      </div>
      <!--SLIDER ANIME-->
      <div class="slider-section">
        <h2>Anime</h2>
        <div class="movie-slider" id="anime-movie-slider"></div>
      </div>
      <!-- SLIDER PHIM HÀN QUỐC -->
      <div class="slider-section">
        <h2>Hàn Quốc</h2>
        <button class="slider-btn prev-btn">
          <i class="fa-solid fa-chevron-left"></i>
        </button>
        <div class="movie-slider" id="korean-movie-slider"></div>
        <button class="slider-btn next-btn">
          <i class="fa-solid fa-chevron-right"></i>
        </button>
      </div>
      <!-- SLIDER PHIM HÀNH ĐỘNG -->
      <div class="slider-section">
        <h2>Hành Động</h2>
        <button class="slider-btn prev-btn">
          <i class="fa-solid fa-chevron-left"></i>
        </button>
        <div class="movie-slider" id="action-movie-slider"></div>
        <button class="slider-btn next-btn">
          <i class="fa-solid fa-chevron-right"></i>
        </button>
      </div>
      <!-- SLIDER PHIM TÌNH CẢM -->
      <div class="slider-section">
        <h2>Tình Cảm</h2>
        <button class="slider-btn prev-btn">
          <i class="fa-solid fa-chevron-left"></i>
        </button>
        <div class="movie-slider" id="romance-movie-slider"></div>
        <button class="slider-btn next-btn">
          <i class="fa-solid fa-chevron-right"></i>
        </button>
      </div>
    </section>

    <!-- TRANG WISHLIST -->
    <section id="page-wishlist" class="page">
      <div class="slider-section">
        <h2>Danh Sách Phim Yêu Thích</h2>
        <div id="wishlist-container" class="movie-slider">
          <!-- Phim sẽ tự động render vào đây qua script.js -->
        </div>
      </div>
    </section>

    <!-- TRANG CHI TIẾT PHIM -->
    <section id="page-detail" class="page">
      <div class="detail-container">
        <div class="detail-poster">
          <img id="detail-poster-img" src="" alt="Poster phim" />
        </div>
        <div class="detail-info">
          <h1 id="detail-title">--</h1>
          <div class="meta">
            <span>
              <i class="fa-solid fa-star"></i>
              <span id="detail-rating">--</span>/10
            </span>
            <span id="detail-year">----</span>
            <span id="detail-episodes-count">-- Tập</span>
          </div>
          <p class="description" id="detail-desc">Đang tải thông tin phim...</p>
          <div class="credits">
            <p>
              <strong>Đạo diễn:</strong>
              <span id="detail-director">Đang cập nhật</span>
            </p>
            <p>
              <strong>Diễn viên:</strong>
              <span id="detail-cast">Đang cập nhật</span>
            </p>
            <p>
              <strong>Thể loại:</strong>
              <span id="detail-genres">Đang cập nhật</span>
            </p>
          </div>

          <div class="episodes-section">
            <h3>Danh Sách Tập</h3>
            <div class="episode-grid" id="detail-episode-grid">
              <!-- Tập phim render động từ JS -->
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- TRANG XEM PHIM (NETFLIX PLAYER INTERFACE) -->
    <section id="page-watch" class="page">
      <div class="watch-container">
        <div class="video-player-wrapper">
          <!-- Video Element chính -->
          <video
            id="video-player"
            playsinline
            style="width: 100%; aspect-ratio: 16/9"
          ></video>

          <!-- Nút Back quay lại trang Chi tiết góc trên bên trái -->
          <button
            class="netflix-back-btn"
            onclick="switchPage('detail')"
            title="Quay lại"
          >
            <i class="fa-solid fa-arrow-left"></i>
          </button>

          <!-- Drawer chọn tập trượt từ lề phải qua màn hình -->
          <div id="netflix-ep-drawer" class="netflix-ep-drawer">
            <div class="drawer-header">
              <h3>Danh Sách Tập</h3>
              <button onclick="toggleEpDrawer()">
                <i class="fa-solid fa-xmark"></i>
              </button>
            </div>
            <div class="episode-grid" id="drawer-episode-grid">
              <!-- Render danh sách tập đè lên Player -->
            </div>
          </div>
        </div>

        <!-- Thông tin tập bên dưới -->
        <div class="watch-details" style="margin-top: 15px">
          <h2>
            <span id="watch-movie-title">Tên Phim</span> -
            <span id="current-ep-title">Tập 1</span>
          </h2>
          <hr />
          <h3>Chọn tập phim:</h3>
          <div class="episode-grid" id="watch-episode-grid">
            <!-- Tập phim render động từ JS -->
          </div>
        </div>
      </div>
    </section>

    <!-- CUSTOM MODAL THÔNG BÁO XEM TIẾP (CĂN GIỮA MÀN HÌNH NETFLIX STYLE) -->
    <div id="resume-modal" class="custom-modal-overlay">
      <div class="custom-modal-box">
        <div class="modal-icon">
          <i class="fa-solid fa-circle-play"></i>
        </div>
        <h3>Tiếp tục xem phim?</h3>
        <p>
          Bạn đã dừng lại ở phút
          <span id="modal-resume-time" class="highlight-time">00:00</span>. Bạn
          có muốn xem tiếp từ vị trí này không?
        </p>
        <div class="modal-actions">
          <button id="btn-modal-cancel" class="btn-modal btn-cancel">
            Xem từ đầu
          </button>
          <button id="btn-modal-confirm" class="btn-modal btn-confirm">
            Xem tiếp
          </button>
        </div>
      </div>
    </div>

    <!-- SCRIPT (Sử dụng đường dẫn tương đối chuẩn xác) -->
    <script src="./Episodes.js"></script>
    <script src="./script.js"></script>
  </body>
</html>
