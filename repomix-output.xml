  font-size: 14px;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* ==========================================
   HOVER POPUP CARD (ULTRA COMPACT FIX)
   ========================================== */
.movie-hover-card {
  position: absolute;
  top: 50%;
  left: 50%;
  width: 210px;
  background: #181818;
  border-radius: 8px;
  box-shadow:
    0 10px 30px rgba(0, 0, 0, 0.95),
    0 0 1px rgba(255, 255, 255, 0.2);
