<file path="Frontend/style.css">
/* ==========================================
   RESET & BASE STYLES
   ========================================== */
* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
  font-family: "Segoe UI", Tahoma, Geneva, Verdana, sans-serif;
}

body {
  background-color: #141414;
  color: #ffffff;
  overflow-x: hidden;
  min-height: 100vh;
}

/* ==========================================
   NAVBAR & SEARCH BOX
   ========================================== */
.navbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 15px 50px;
  background-color: rgba(0, 0, 0, 0.9);
  position: sticky;
  top: 0;
  z-index: 1000;
  gap: 20px;
}

.logo {
  font-size: 24px;
  font-weight: bold;
  cursor: pointer;
  color: #e50914;
  user-select: none;
}

.logo span {
  color: #fff;
}

.nav-links {
  display: flex;
  list-style: none;
  gap: 20px;
  align-items: center;
}

.nav-links li {
  cursor: pointer;
  transition: color 0.3s;
  font-size: 15px;
  font-weight: 500;
}

.nav-links li:hover,
.nav-links li.active {
  color: #e50914;
}

/* KHỐI TÌM KIẾM (NETFLIX STYLE) */
.search-box {
  position: relative;
  display: flex;
  align-items: center;
  background-color: rgba(0, 0, 0, 0.6);
  border: 1px solid rgba(255, 255, 255, 0.3);
  border-radius: 20px;
  padding: 4px 12px;
  transition: all 0.3s cubic-bezier(0.25, 0.8, 0.25, 1);
}

.search-box:focus-within {
  background-color: rgba(0, 0, 0, 0.95);
  border-color: #e50914;
  box-shadow: 0 0 10px rgba(229, 9, 20, 0.6);
}

.search-box input {
  background: transparent;
  border: none;
  outline: none;
  color: #ffffff;
  padding: 6px 10px 6px 4px;
  font-size: 14px;
  width: 160px;
  transition: width 0.3s ease;
}

.search-box input::placeholder {
  color: #aaaaaa;
  font-size: 13px;
}

.search-box input:focus {
  width: 240px;
}

.search-box button {
  background: transparent;
  border: none;
  color: #aaaaaa;
  cursor: pointer;
  padding: 4px;
  display: flex;
  align-items: center;
  justify-content: center;
  transition:
    color 0.2s ease,
    transform 0.2s ease;
}

.search-box button:hover {
  color: #e50914;
  transform: scale(1.1);
}

/* ==========================================
   DROPDOWN MENU THỂ LOẠI (NETFLIX STYLE)
   ========================================== */
.nav-links .dropdown {
  position: relative;
}

.dropdown-toggle {
  display: flex;
  align-items: center;
  gap: 6px;
  cursor: pointer;
}

.dropdown-toggle i {
  font-size: 11px;
  transition: transform 0.3s ease;
}

/* Bảng menu xổ xuống */
.dropdown-menu {
  position: absolute;
  top: 100%;
  left: -20px;
  background-color: rgba(20, 20, 20, 0.95);
  border: 1px solid rgba(255, 255, 255, 0.15);
  border-radius: 6px;
  padding: 15px 20px;
  width: 520px;
  box-shadow: 0 10px 30px rgba(0, 0, 0, 0.9);
  backdrop-filter: blur(10px);
  z-index: 1001;

  /* Hiệu ứng ẩn hiện mượt mà */
  opacity: 0;
  visibility: hidden;
  transform: translateY(10px);
  transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
}

/* Khi hover vào thẻ Thể Loại hoặc bấm mở */
.nav-links .dropdown:hover .dropdown-menu,
.nav-links .dropdown.active .dropdown-menu {
  opacity: 1;
  visibility: visible;
  transform: translateY(0);
}

.nav-links .dropdown:hover .dropdown-toggle i,
.nav-links .dropdown.active .dropdown-toggle i {
  transform: rotate(180deg);
}

/* Chia danh sách thể loại thành 3 cột gọn gàng */
.genre-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 10px 15px;
}

.genre-grid span {
  font-size: 13px;
  color: #b3b3b3;
  cursor: pointer;
  transition:
    color 0.2s ease,
    transform 0.2s ease;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.genre-grid span:hover {
  color: #ffffff;
  transform: translateX(3px);
}

/* ==========================================
   ROUTER PAGE CONTROL
   ========================================== */
.page {
  display: none;
  padding-bottom: 50px;
}

.page.active {
  display: block;
}

/* ==========================================
   1. TRANG CHỦ (HOME)
   ========================================== */
.hero-banner {
  position: relative;
  height: 88vh;
  min-height: 560px;
  max-height: 820px;
  background-size: contain;
  background-position: right center;
  background-repeat: no-repeat;
  background-color: #141414;
  display: flex;
  align-items: center;
  padding: 0 50px;
  transition: background-image 0.8s ease-in-out;
}

.hero-overlay {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background:
    linear-gradient(
      to right,
      #141414 30%,
      rgba(20, 20, 20, 0.7) 60%,
      transparent 100%
    ),
    linear-gradient(to top, #141414 5%, transparent 30%);
}

.hero-content {
  position: relative;
  max-width: 600px;
  z-index: 2;
}

.badge {
  background-color: #e50914;
  padding: 4px 10px;
  border-radius: 4px;
  font-size: 12px;
  font-weight: bold;
  display: inline-block;
  margin-bottom: 10px;
}

.hero-content h1 {
  font-size: 48px;
  margin: 10px 0 15px 0;
  line-height: 1.1;
}

.hero-content p {
  color: #ccc;
  line-height: 1.5;
  margin-bottom: 20px;
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.btn {
  padding: 10px 20px;
  border: none;
  border-radius: 4px;
  font-size: 16px;
  font-weight: bold;
  cursor: pointer;
  margin-right: 10px;
  transition:
    opacity 0.3s,
    transform 0.2s;
  display: inline-flex;
  align-items: center;
  gap: 8px;
}

.btn-primary {
  background-color: #e50914;
  color: white;
}

.btn-secondary {
  background-color: rgba(255, 255, 255, 0.2);
  color: white;
}

.btn:hover {
  opacity: 0.85;
  transform: scale(1.02);
}

/* Hero Dots cho Auto Slider */
.hero-dots {
  position: absolute;
  bottom: 20px;
  right: 50px;
  display: flex;
  gap: 8px;
  z-index: 10;
}

.hero-dot {
  width: 10px;
  height: 10px;
  background-color: rgba(255, 255, 255, 0.4);
  border-radius: 50%;
  cursor: pointer;
  transition: all 0.3s ease;
}

.hero-dot:hover {
  background-color: rgba(255, 255, 255, 0.8);
}

.hero-dot.active {
  background-color: #e50914;
  width: 26px;
  border-radius: 10px;
}

/* ==========================================
   SLIDER SECTION & MOVIE CARDS
   ========================================== */
.slider-section {
  padding: 20px 50px;
  position: relative;
}

.slider-section h2 {
  margin-bottom: 12px;
  font-size: 20px;
  font-weight: 600;
}

.movie-slider {
  display: flex;
  gap: 15px;
  overflow-x: auto;
  overflow-y: visible;
  padding: 25px 10px 35px 10px;
  margin: -10px -10px;
  scroll-behavior: smooth;
}

.movie-slider::-webkit-scrollbar {
  height: 6px;
}

.movie-slider::-webkit-scrollbar-thumb {
  background: #333;
  border-radius: 4px;
}

/* Movie Card Gốc */
.movie-card {
