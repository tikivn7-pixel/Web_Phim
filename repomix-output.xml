  aspect-ratio: 16 / 9;
  height: 100px;
  overflow: hidden;
  background: #000;
}

.hover-banner {
  width: 100% !important;
  height: 100% !important;
  object-fit: cover !important;
  object-position: center;
  border-radius: 0 !important;
  display: block;
  filter: brightness(0.9);
  transition:
    filter 0.3s ease,
    transform 0.5s ease;
}

.movie-hover-card:hover .hover-banner {
  filter: brightness(0.75);
  transform: scale(1.05);
}

.hover-center-play {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%) scale(0.85);
  width: 36px;
  height: 36px;
  background-color: rgba(229, 9, 20, 0.9);
  color: #ffffff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 13px;
  padding-left: 2px;
  box-shadow: 0 4px 15px rgba(229, 9, 20, 0.6);
  transition: all 0.25s cubic-bezier(0.175, 0.885, 0.32, 1.275);
  z-index: 5;
}

.movie-card:hover .hover-center-play {
  transform: translate(-50%, -50%) scale(1);
}

.hover-center-play:hover {
  background-color: #e50914;
  transform: translate(-50%, -50%) scale(1.15) !important;
  box-shadow: 0 0 20px rgba(229, 9, 20, 0.9);
}

.hover-content {
  padding: 6px 8px;
  background: #181818;
}

.hover-title {
  font-size: 12px;
  font-weight: 700;
  color: #fff;
  margin-bottom: 2px;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.hover-subtitle {
  font-size: 10px;
  color: #e50914;
  font-weight: 600;
  margin-bottom: 5px;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.hover-actions {
  display: flex;
  align-items: center;
  gap: 5px;
  margin-bottom: 4px;
}

.btn-hover {
  border: none;
  font-size: 10px;
  font-weight: 600;
  cursor: pointer;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 4px;
  transition: all 0.2s ease;
}

.btn-hover.play {
  background-color: #ffffff;
  color: #000000;
  border-radius: 3px;
  padding: 4px 8px;
  flex: 1;
  font-weight: 700;
}

.btn-hover.play:hover {
  background-color: rgba(255, 255, 255, 0.85);
  transform: scale(1.02);
}

.btn-hover.icon {
  width: 24px;
  height: 24px;
  padding: 0;
  background-color: rgba(42, 42, 42, 0.8);
  border: 1px solid rgba(255, 255, 255, 0.2);
  color: #fff;
  border-radius: 50%;
  font-size: 10px;
}

.btn-hover.icon:hover {
  border-color: #ffffff;
  background-color: rgba(255, 255, 255, 0.2);
  transform: scale(1.1);
}

.btn-hover.icon.active {
  background-color: #e50914;
  border-color: #e50914;
  color: #fff;
}

.hover-tags {
  display: flex;
  gap: 4px;
  align-items: center;
  flex-wrap: wrap;
}

.badge-tag {
  font-size: 8px;
  background: rgba(255, 255, 255, 0.12);
  color: #ddd;
  padding: 1px 3px;
  border-radius: 2px;
  font-weight: 500;
}

.badge-tag.imdb {
  background: #f5c518;
  color: #000;
  font-weight: bold;
}

.hover-genres {
  display: none !important;
}

/* ==========================================
   2. TRANG WISHLIST (DANH SÁCH CỦA TÔI)
   ========================================== */
.wishlist-section {
  padding: 30px 50px;
}

#wishlist-container {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
  gap: 35px 20px;
  overflow: visible;
  padding: 20px 0 50px 0;
}

#wishlist-container .movie-card {
  min-width: unset;
  width: 100%;
}

/* ==========================================
   3. TRANG CHI TIẾT (DETAIL)
   ========================================== */
.detail-container {
  display: flex;
  padding: 50px;
  gap: 40px;
  max-width: 1200px;
  margin: 0 auto;
}

.detail-poster img {
  width: 320px;
  border-radius: 12px;
  box-shadow: 0 10px 30px rgba(0, 0, 0, 0.8);
  display: block;
}

.detail-info {
  flex: 1;
}

.detail-info h1 {
  font-size: 36px;
  margin-bottom: 10px;
}

.meta {
  display: flex;
  gap: 15px;
  color: #ffc107;
  margin-bottom: 20px;
  font-weight: 500;
}

.description {
  color: #ddd;
  line-height: 1.6;
  margin-bottom: 20px;
  font-size: 15px;
}

.credits p {
  margin-bottom: 8px;
  color: #bbb;
  font-size: 14px;
}

.episodes-section {
  margin-top: 30px;
}

.episodes-section h3 {
  margin-bottom: 15px;
  font-size: 18px;
}

.episode-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
}

.ep-btn {
  background: #2b2b2b;
  color: white;
  border: 1px solid #444;
  padding: 10px 20px;
  border-radius: 6px;
  cursor: pointer;
  transition: all 0.2s;
  font-weight: 500;
}

.ep-btn:hover,
.ep-btn.active {
  background: #e50914;
  border-color: #e50914;
}

/* ==========================================
   3B. TRANG CHI TIẾT - GIAO DIỆN MỚI (FD = FILM DETAIL)
   ========================================== */
.fd-wrap {
  max-width: 1200px;
  margin: 0 auto;
  padding: 20px 50px 60px;
}

/* --- Breadcrumb --- */
.fd-breadcrumb {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 6px;
  font-size: 13px;
  color: #888;
  padding: 10px 0 20px;
}

.fd-breadcrumb a {
  color: #b3b3b3;
  text-decoration: none;
  transition: color 0.2s;
}

.fd-breadcrumb a:hover {
  color: #e50914;
}

.fd-breadcrumb span.sep {
  color: #555;
}

.fd-breadcrumb span.current {
  color: #777;
}

/* --- Layout: main + sidebar --- */
.fd-layout {
  display: grid;
  grid-template-columns: 1fr 300px;
  gap: 30px;
  align-items: start;
}

.fd-main {
  min-width: 0;
}

/* --- Hero card (poster + info) --- */
.fd-hero {
  display: flex;
  gap: 25px;
  background: #181818;
  border: 1px solid rgba(255, 255, 255, 0.06);
  border-radius: 12px;
  padding: 20px;
  margin-bottom: 20px;
}

.fd-poster {
  position: relative;
  width: 190px;
  flex-shrink: 0;
  border-radius: 8px;
  overflow: hidden;
  box-shadow: 0 10px 25px rgba(0, 0, 0, 0.6);
}

.fd-poster img {
  width: 100%;
  height: 100%;
  aspect-ratio: 2 / 3;
  object-fit: cover;
  display: block;
}

.fd-follow-badge {
  position: absolute;
  top: 8px;
  left: 8px;
  z-index: 3;
  display: flex;
  align-items: center;
  gap: 5px;
  background: rgba(0, 0, 0, 0.65);
  border: 1px solid rgba(255, 255, 255, 0.2);
  color: #fff;
  font-size: 11px;
  padding: 4px 9px;
  border-radius: 20px;
  cursor: pointer;
  transition: all 0.2s;
}

.fd-follow-badge:hover {
  border-color: #e50914;
}

.fd-follow-badge.active {
  background: rgba(229, 9, 20, 0.85);
  border-color: #e50914;
}

.fd-play-overlay {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(0, 0, 0, 0.25);
  cursor: pointer;
  opacity: 0;
  transition: opacity 0.25s ease;
}

.fd-poster:hover .fd-play-overlay {
  opacity: 1;
}

.fd-play-overlay i {
  width: 46px;
  height: 46px;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.9);
  color: #141414;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 16px;
  padding-left: 3px;
  transition: transform 0.2s;
}

.fd-play-overlay:hover i {
  transform: scale(1.1);
  background: #e50914;
  color: #fff;
}

.fd-watch-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  width: 100%;
  margin-top: 10px;
  padding: 9px 0;
  background: #e50914;
  color: #fff;
  border: none;
  border-radius: 5px;
  font-weight: 700;
  font-size: 13px;
  cursor: pointer;
  transition: all 0.2s;
}

.fd-watch-btn:hover {
  background: #f40612;
  transform: translateY(-1px);
}

.fd-info {
  flex: 1;
  min-width: 0;
}

.fd-title {
  font-size: 1.7rem;
  margin-bottom: 6px;
  line-height: 1.2;
}

.fd-alt-title {
  color: #888;
  font-size: 13px;
  margin-bottom: 12px;
}

.fd-desc {
  color: #aaa;
  font-size: 14px;
  line-height: 1.6;
  margin-bottom: 16px;
  display: -webkit-box;
  -webkit-line-clamp: 4;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.fd-rating-row {
  display: flex;
  align-items: center;
  gap: 14px;
  flex-wrap: wrap;
}

.fd-score-badge {
  width: 46px;
  height: 46px;
  border-radius: 50%;
  border: 3px solid #46d369;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 12px;
  font-weight: 700;
  color: #46d369;
  flex-shrink: 0;
}

.fd-stars {
  color: #f5c518;
  font-size: 13px;
  letter-spacing: 2px;
}

.fd-meta-line {
  color: #888;
  font-size: 12px;
  display: flex;
  align-items: center;
  gap: 6px;
  flex-wrap: wrap;
}

/* --- Phần phim (nút chuyển season) --- */
#parts-section h3 {
  font-size: 15px;
}

#detail-parts-grid .episode-btn {
  background: #2b2b2b;
  color: #ddd;
  border: 1px solid #444;
  padding: 8px 16px;
  border-radius: 6px;
  cursor: pointer;
  font-size: 13px;
  font-weight: 600;
  transition: all 0.2s;
}

#detail-parts-grid .episode-btn:hover {
  background: #3a3a3a;
  border-color: #666;
}

#detail-parts-grid .episode-btn.active {
  background: #46d369;
  border-color: #46d369;
  color: #0b1f0f;
}

/* --- Tabs --- */
.fd-tabs {
  display: flex;
  gap: 25px;
  border-bottom: 1px solid #2a2a2a;
  margin: 25px 0 20px;
  overflow-x: auto;
}

.fd-tab-btn {
  background: none;
  border: none;
  color: #888;
  font-size: 14px;
  font-weight: 600;
  padding: 10px 2px 14px;
  cursor: pointer;
  white-space: nowrap;
  border-bottom: 2px solid transparent;
  transition: color 0.2s;
  display: flex;
  align-items: center;
  gap: 7px;
}

.fd-tab-btn:hover {
  color: #ccc;
}

.fd-tab-btn.active {
  color: #46d369;
  border-bottom-color: #46d369;
}

.fd-tab-panel {
  display: none;
}

.fd-tab-panel.active {
  display: block;
}

.fd-placeholder {
  color: #777;
  font-size: 13px;
  padding: 30px 0;
  text-align: center;
}

.fd-info-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 10px 30px;
}

.fd-info-item {
  display: flex;
  gap: 8px;
  font-size: 13px;
  color: #999;
  padding: 6px 0;
  border-bottom: 1px dashed rgba(255, 255, 255, 0.06);
}

.fd-info-item i {
  color: #46d369;
  margin-top: 2px;
  width: 14px;
  flex-shrink: 0;
}

.fd-info-item strong {
  color: #ccc;
  margin-right: 4px;
}

.fd-info-item span,
.fd-info-item a {
  color: #999;
}

.fd-info-item a {
  text-decoration: none;
}

.fd-info-item a:hover {
  color: #46d369;
}

@media (max-width: 640px) {
  .fd-info-grid {
    grid-template-columns: 1fr;
  }
}

/* --- Sidebar: gợi ý phim liên quan --- */
.fd-sidebar h3 {
  font-size: 15px;
  margin-bottom: 14px;
  border-bottom: 2px solid #e50914;
  display: inline-block;
  padding-bottom: 6px;
}

.fd-suggest-item {
  display: flex;
  gap: 10px;
  cursor: pointer;
  padding: 8px 6px;
  border-radius: 6px;
  transition: background 0.2s;
  margin-bottom: 4px;
}

.fd-suggest-item:hover {
  background: rgba(255, 255, 255, 0.05);
}

.fd-suggest-item img {
  width: 55px;
  height: 78px;
  object-fit: cover;
  border-radius: 4px;
  flex-shrink: 0;
}

.fd-suggest-info h4 {
  font-size: 13px;
  color: #eee;
  margin-bottom: 4px;
  line-height: 1.3;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.fd-suggest-info span {
  font-size: 11px;
  color: #777;
}

@media (max-width: 900px) {
  .fd-layout {
    grid-template-columns: 1fr;
  }
  .fd-wrap {
    padding: 15px 20px 40px;
  }
  .fd-hero {
    flex-direction: column;
  }
  .fd-poster {
    width: 160px;
  }
}

/* ==========================================
   4. TRANG XEM PHIM (WATCH & NETFLIX PLAYER)
   ========================================== */
.watch-container {
  max-width: 1100px;
  margin: 20px auto;
  padding: 0 20px;
}

.video-player-wrapper {
  position: relative;
  width: 100%;
  border-radius: 8px;
  overflow: hidden;
  background: #000;
  box-shadow: 0 10px 30px rgba(0, 0, 0, 0.8);
}

.video-player-wrapper video {
  width: 100%;
  aspect-ratio: 16 / 9;
  background: #000;
  border-radius: 8px;
  display: block;
}

/* TỐI ƯU TOÀN MÀN HÌNH (FULLSCREEN FIX CHO MOBILE & WEB) */
.video-player-wrapper:fullscreen,
.video-player-wrapper:-webkit-full-screen,
.video-player-wrapper:-moz-full-screen {
  width: 100vw !important;
  height: 100vh !important;
  max-width: none !important;
  max-height: none !important;
  border-radius: 0 !important;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #000 !important;
}

.video-player-wrapper video:fullscreen,
.video-player-wrapper video:-webkit-full-screen,
.video-player-wrapper video:-moz-full-screen {
  width: 100vw !important;
  height: 100vh !important;
  object-fit: contain !important;
  border-radius: 0 !important;
}

.netflix-back-btn {
  position: absolute;
  top: 20px;
  left: 20px;
  z-index: 10;
  background: rgba(0, 0, 0, 0.6);
  color: #fff;
  border: none;
  border-radius: 50%;
  width: 45px;
  height: 45px;
  font-size: 1.2rem;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  transition:
    background 0.2s,
    transform 0.2s;
}

.netflix-back-btn:hover {
  background: #e50914;
  transform: scale(1.1);
}

.netflix-ep-drawer {
  position: absolute;
  top: 0;
  right: -320px;
  width: 300px;
  height: 100%;
  background: rgba(15, 15, 15, 0.95);
  backdrop-filter: blur(10px);
  z-index: 20;
  padding: 20px;
  box-sizing: border-box;
  transition: right 0.3s ease-in-out;
  overflow-y: auto;
}

.netflix-ep-drawer.open {
  right: 0;
}

.netflix-ep-drawer .drawer-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20px;
  border-bottom: 1px solid #333;
  padding-bottom: 10px;
}

.netflix-ep-drawer .drawer-header h3 {
  margin: 0;
  color: #fff;
  font-size: 1.1rem;
}

.netflix-ep-drawer .drawer-header button {
  background: none;
  border: none;
  color: #fff;
  font-size: 1.2rem;
  cursor: pointer;
}

.netflix-custom-tools {
  display: flex;
  align-items: center;
  gap: 5px;
  margin-left: 5px;
}

.watch-details {
  margin-top: 20px;
}

.watch-details hr {
  border: 0;
  border-top: 1px solid #333;
  margin: 15px 0;
}

.watch-details h3 {
  margin-bottom: 15px;
}

/* ==========================================
   4B. TRANG XEM PHIM - GIAO DIỆN MỚI (WP = WATCH PAGE)
   ========================================== */
.video-wrapper {
  position: relative;
  width: 100%;
  background: #000;
  border-radius: 10px 10px 0 0;
  overflow: hidden;
  aspect-ratio: 16 / 9;
}

.video-wrapper video {
  width: 100%;
  height: 100%;
  display: block;
}

.video-wrapper:fullscreen,
.video-wrapper:-webkit-full-screen,
.video-wrapper:-moz-full-screen {
  width: 100vw !important;
  height: 100vh !important;
  max-width: none !important;
  max-height: none !important;
  border-radius: 0 !important;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #000 !important;
}

.video-wrapper video:fullscreen,
.video-wrapper video:-webkit-full-screen,
.video-wrapper video:-moz-full-screen {
  width: 100vw !important;
  height: 100vh !important;
  object-fit: contain !important;
  border-radius: 0 !important;
}

.wp-player-card {
  background: #181818;
  border: 1px solid rgba(255, 255, 255, 0.06);
  border-radius: 10px;
  overflow: hidden;
  margin-bottom: 20px;
}

.wp-player-toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 12px;
  padding: 16px 18px;
}

.wp-now-playing h1 {
  font-size: 1.3rem;
  margin-bottom: 4px;
  line-height: 1.3;
}

.wp-now-playing p {
  color: #46d369;
  font-size: 13px;
  font-weight: 600;
}

.wp-nav-btns {
  display: flex;
  align-items: center;
  gap: 14px;
  flex-wrap: wrap;
}

.wp-nav-btn {
  display: inline-flex;
  align-items: center;
  gap: 7px;
  background: #2b2b2b;
  color: #fff;
  border: 1px solid #444;
  padding: 8px 14px;
  border-radius: 6px;
  font-size: 13px;
  font-weight: 600;
  cursor: pointer;
  transition: all 0.2s;
}

.wp-nav-btn:hover:not(:disabled) {
  background: #e50914;
  border-color: #e50914;
}

.wp-nav-btn:disabled {
  opacity: 0.35;
  cursor: not-allowed;
}

.wp-autonext {
  display: flex;
  align-items: center;
  gap: 6px;
  font-size: 12px;
  color: #aaa;
  cursor: pointer;
  user-select: none;
}

.wp-autonext input {
  accent-color: #e50914;
  cursor: pointer;
}

.wp-ep-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 10px;
  margin-bottom: 15px;
}

.wp-ep-search {
  display: flex;
  align-items: center;
  gap: 8px;
  background: rgba(255, 255, 255, 0.06);
  border: 1px solid rgba(255, 255, 255, 0.15);
  border-radius: 20px;
  padding: 6px 14px;
  color: #888;
}

.wp-ep-search input {
  background: transparent;
  border: none;
  outline: none;
  color: #fff;
  font-size: 13px;
  width: 120px;
}

.wp-episode-scroll {
  max-height: 260px;
  overflow-y: auto;
  padding-right: 4px;
}

.wp-episode-scroll::-webkit-scrollbar {
  width: 6px;
}

.wp-episode-scroll::-webkit-scrollbar-thumb {
  background: #333;
  border-radius: 4px;
}

.wp-movie-mini {
  display: flex;
  gap: 16px;
  background: #181818;
  border: 1px solid rgba(255, 255, 255, 0.06);
  border-radius: 10px;
  padding: 16px;
  margin-top: 25px;
}

.wp-movie-mini img {
  width: 90px;
  height: 128px;
  object-fit: cover;
  border-radius: 6px;
  flex-shrink: 0;
}

.wp-mini-info h4 {
  font-size: 15px;
  margin-bottom: 6px;
}

.wp-mini-info p {
  color: #999;
  font-size: 12.5px;
  line-height: 1.5;
  margin-bottom: 4px;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.wp-mini-genres {
  color: #46d369 !important;
  -webkit-line-clamp: 1 !important;
}

.wp-mini-link {
  color: #e50914;
  font-size: 12.5px;
  font-weight: 600;
  text-decoration: none;
  display: inline-flex;
  align-items: center;
  gap: 5px;
}

.wp-mini-link:hover {
  text-decoration: underline;
}

@media (max-width: 640px) {
  .wp-player-toolbar {
    flex-direction: column;
    align-items: flex-start;
  }
  .wp-movie-mini {
    flex-direction: column;
  }
  .wp-movie-mini img {
    width: 80px;
    height: 114px;
  }
}

/* ==========================================
   4C. PLYR PLAYER - NETFLIX RED SKIN
   ========================================== */
.video-wrapper {
  --plyr-color-main: #e50914;
  --plyr-video-background: #000;
  --plyr-control-icon-size: 20px;
  --plyr-control-spacing: 14px;
  --plyr-control-radius: 4px;
  --plyr-video-control-color: #ffffff;
  --plyr-video-control-color-hover: #ffffff;
  --plyr-video-control-background-hover: transparent;
  --plyr-tooltip-background: rgba(10, 10, 10, 0.95);
  --plyr-tooltip-color: #fff;
  --plyr-tooltip-radius: 4px;
  --plyr-menu-background: rgba(20, 20, 20, 0.97);
  --plyr-menu-color: #eee;
  --plyr-menu-radius: 8px;
  --plyr-menu-arrow-size: 6px;
  --plyr-font-family: "Segoe UI", Tahoma, Geneva, Verdana, sans-serif;
  --plyr-font-size-small: 12px;
  --plyr-font-size-base: 13px;
  --plyr-font-weight-regular: 500;
}

/* Nút play lớn ở giữa video */
.plyr__control--overlaid {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  background: rgba(229, 9, 20, 0.85);
  border: 2px solid rgba(255, 255, 255, 0.8);
  padding: 18px;
  transition: all 0.2s ease;
  display: flex;
  align-items: center;
  justify-content: center;
}

.plyr__control--overlaid:hover,
.plyr__control--overlaid:focus-visible {
  background: #e50914;
  transform: scale(1.08);
}

/* Thanh điều khiển dưới - nền gradient trong suốt kiểu Netflix */
.plyr--video .plyr__controls {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: linear-gradient(
    to top,
    rgba(0, 0, 0, 0.85) 0%,
    rgba(0, 0, 0, 0.55) 55%,
    transparent 100%
  );
  padding: 30px 16px 12px;
}

/* Icon nút bấm: play/pause, rewind, forward, mute, settings, pip, fullscreen */
.plyr__control {
  color: #fff;
  transition:
    color 0.2s ease,
    transform 0.15s ease;
}

.plyr__control svg {
  filter: drop-shadow(0 1px 2px rgba(0, 0, 0, 0.6));
}

.plyr__control:hover,
.plyr__control[aria-expanded="true"] {
  background: transparent !important;
  color: #e50914 !important;
  transform: scale(1.12);
}

/* Thanh tiến trình (progress bar) */
.plyr__progress input[type="range"] {
  color: #e50914;
}

.plyr__progress__buffer {
  color: rgba(255, 255, 255, 0.35);
}

.plyr__progress input[type="range"]::-webkit-slider-thumb {
  box-shadow: 0 0 0 4px rgba(229, 9, 20, 0.25);
}

/* Hiển thị thời gian */
.plyr__time {
  font-variant-numeric: tabular-nums;
  color: #fff;
  font-size: 13px;
  font-weight: 500;
}

.plyr__time--duration {
  color: rgba(255, 255, 255, 0.65);
}

/* Thanh âm lượng */
.plyr__volume input[type="range"] {
  color: #e50914;
}

/* Menu Settings (bánh răng) */
.plyr__menu__container {
  border: 1px solid rgba(255, 255, 255, 0.08);
}

.plyr__menu__container
  .plyr__control[role="menuitemradio"][aria-checked="true"]::before {
  background: #e50914;
}

/* Tooltip nhỏ khi hover */
.plyr__tooltip {
  font-weight: 600;
}

/* Thanh loading buffer khi mạng chậm */
.plyr--loading .plyr__control--overlaid {
  opacity: 0.6;
}

@media (max-width: 640px) {
  .plyr--video .plyr__controls {
    padding: 20px 8px 8px;
  }
  :root {
    --plyr-control-spacing: 8px;
  }
}

/* ==========================================
   5. CUSTOM MODAL POPUP (NETFLIX DARK STYLE)
   ========================================== */
.custom-modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  width: 100vw;
  height: 100vh;
  background: rgba(0, 0, 0, 0.75);
  backdrop-filter: blur(8px);
  z-index: 10000;
  display: flex;
  align-items: center;
  justify-content: center;

  opacity: 0;
  visibility: hidden;
  transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
}

.custom-modal-overlay.active {
  opacity: 1;
  visibility: visible;
}

.custom-modal-box {
  background: #181818;
  border: 1px solid rgba(255, 255, 255, 0.1);
  border-radius: 12px;
  padding: 24px 28px;
  width: 90%;
  max-width: 380px;
  text-align: center;
  box-shadow:
    0 20px 40px rgba(0, 0, 0, 0.8),
    0 0 15px rgba(229, 9, 20, 0.15);

  transform: scale(0.85) translateY(20px);
  transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
}

.custom-modal-overlay.active .custom-modal-box {
  transform: scale(1) translateY(0);
}

.modal-icon {
  font-size: 38px;
  color: #e50914;
  margin-bottom: 12px;
}

.custom-modal-box h3 {
  font-size: 18px;
  font-weight: 700;
  color: #ffffff;
  margin-bottom: 8px;
}

.custom-modal-box p {
  font-size: 13px;
  color: #bbbbbb;
  line-height: 1.5;
  margin-bottom: 20px;
}

.highlight-time {
  color: #e50914;
  font-weight: bold;
}

.modal-actions {
  display: flex;
  gap: 12px;
}

.btn-modal {
  flex: 1;
  padding: 10px 16px;
  border-radius: 6px;
  font-size: 13px;
  font-weight: 600;
  cursor: pointer;
  border: none;
  transition: all 0.2s ease;
}

.btn-cancel {
  background: rgba(255, 255, 255, 0.1);
  color: #cccccc;
}

.btn-cancel:hover {
  background: rgba(255, 255, 255, 0.2);
  color: #ffffff;
}

.btn-confirm {
  background: #e50914;
  color: #ffffff;
  box-shadow: 0 4px 12px rgba(229, 9, 20, 0.4);
}

.btn-confirm:hover {
  background: #f40612;
  transform: translateY(-1px);
  box-shadow: 0 6px 16px rgba(229, 9, 20, 0.6);
}

/* ==========================================
   RESPONSIVE
   ========================================== */
@media (max-width: 768px) {
  .navbar {
    padding: 12px 20px;
  }
  .hero-banner {
    padding: 0 20px;
    height: 50vh;
  }
  .hero-content h1 {
    font-size: 30px;
  }
  .slider-section {
    padding: 20px;
  }
  .detail-container {
    flex-direction: column;
    padding: 20px;
  }
  .detail-poster img {
    width: 100%;
    max-width: 280px;
    margin: 0 auto;
  }
}

/* Bao bọc danh sách slider để định vị nút bấm */
.slider-section {
  position: relative;
}

/* Kiểu dáng cho nút mũi tên trái/phải */
.slider-btn {
  position: absolute;
  top: 55%;
  transform: translateY(-50%);
  background: rgba(0, 0, 0, 0.7);
  color: white;
  border: none;
  font-size: 1.5rem;
  width: 45px;
  height: 80px;
  cursor: pointer;
  z-index: 10;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 4px;
  opacity: 0;
  transition:
    opacity 0.3s,
    background 0.3s;
}

.slider-section:hover .slider-btn {
  opacity: 1;
}

.slider-btn:hover {
  background: rgba(0, 0, 0, 0.9);
}

.prev-btn {
  left: 10px;
}

.next-btn {
  right: 10px;
}
