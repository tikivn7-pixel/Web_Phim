    <!-- Script xử lý nhận dữ liệu từ URL và hiển thị -->
    <script src="script.js"></script>
    <script>
      const params = new URLSearchParams(window.location.search);
      const title = params.get("title") || "Phim";
      const poster = params.get("poster") || "";
      const desc = params.get("desc") || "";
      let episodes = parseInt(params.get("episodes")) || 20;
      const slug = params.get("slug") || "";

      // Gán dữ liệu tĩnh từ URL lên giao diện trước cho mượt (sẽ được API
      // cập nhật lại chính xác hơn ngay sau khi tải xong bên dưới)
      document.getElementById("page-title").innerText = title;
      document.getElementById("detail-title").innerText = title;
      document.getElementById("detail-poster-img").src = poster;
      document.getElementById("detail-poster-img").onerror = function () {
        this.src = "https://placehold.co/350x500";
      };
      document.getElementById("detail-desc").innerText = desc;
      document.getElementById("detail-episodes-count").innerText =
        `${episodes} Tập`;

      // Chuyển tới xem tập 1 ngay lập tức
      function fdWatchNow() {
        const watchParams = new URLSearchParams({
          title,
          ep: 1,
          slug,
          poster,
          episodes,
        });
        window.location.href = `watch.html?${watchParams.toString()}`;
      }

      // Chuyển tab (Thông tin phim / Nhân vật / Trailer / Hình ảnh)
      function fdSwitchTab(tab) {
        document.querySelectorAll(".fd-tab-btn").forEach((btn) => {
          btn.classList.toggle("active", btn.dataset.tab === tab);
        });
        document.querySelectorAll(".fd-tab-panel").forEach((panel) => {
          panel.classList.remove("active");
        });
        const activePanel = document.getElementById(`fd-panel-${tab}`);
        if (activePanel) activePanel.classList.add("active");
      }

      // Nút "Theo dõi" -> dùng chung wishlist đã có sẵn của site
      function fdIsFollowed() {
        const list = typeof getWishlist === "function" ? getWishlist() : [];
        return list.some((item) => item.title === title);
      }

      function fdUpdateFollowUI() {
        const followed = fdIsFollowed();
        const btn = document.getElementById("fd-follow-btn");
        const icon = document.getElementById("fd-follow-icon");
        const text = document.getElementById("fd-follow-text");
        if (!btn || !icon || !text) return;
        btn.classList.toggle("active", followed);
        icon.className = followed
          ? "fa-solid fa-bookmark"
          : "fa-regular fa-bookmark";
        text.innerText = followed ? "Đang theo dõi" : "Theo dõi";
      }

      function fdToggleFollow() {
        if (typeof toggleWishlist === "function") {
          toggleWishlist({ title, poster, desc, episodes, slug });
        }
        fdUpdateFollowUI();
      }

      // Breadcrumb: Trang chủ / <thể loại...> / <tên phim> / Thông tin
      function fdRenderBreadcrumb(genresStr) {
        const bc = document.getElementById("fd-breadcrumb");
        if (!bc) return;
        const safe = typeof escapeHtml === "function" ? escapeHtml : (s) => s;
        const genres = (genresStr || "")
          .split(",")
          .map((g) => g.trim())
          .filter(Boolean);

        let html = `<a href="index.html">Trang chủ</a>`;
        genres.forEach((g) => {
          html += `<span class="sep">/</span><span>${safe(g)}</span>`;
        });
        html += `<span class="sep">/</span><span>${safe(title)}</span>`;
        html += `<span class="sep">/</span><span class="current">Thông tin</span>`;
        bc.innerHTML = html;
      }

      // Render danh sách nút tập phim, dùng chung cho lần đầu (từ URL param)
      // và lần render lại sau khi có số tập chính xác từ API
      function fdRenderEpisodeGrid(episodeCount) {
        const grid = document.getElementById("detail-episode-grid");
        if (!grid) return;
        grid.innerHTML = "";
        for (let i = 1; i <= episodeCount; i++) {
          const btn = document.createElement("button");
          btn.className = "ep-btn" + (i === 1 ? " active" : "");
          btn.innerText = `Tập ${i}`;
          btn.onclick = () => {
            const watchParams = new URLSearchParams({
              title,
              ep: i,
              slug,
              poster,
              episodes: episodeCount,
            });
            window.location.href = `watch.html?${watchParams.toString()}`;
          };
          grid.appendChild(btn);
        }
      }

      // Render tạm ngay bằng số tập lấy từ URL param cho mượt
      fdRenderEpisodeGrid(episodes);

      window.addEventListener("DOMContentLoaded", async () => {
        fdUpdateFollowUI();

        // Lấy dữ liệu chuẩn của phim trực tiếp từ MySQL qua API (thay vì
        // đọc window.globalMoviesList tĩnh như trước - giờ danh sách đó
        // chỉ populate dần qua các lần fetch, không đảm bảo có sẵn ở đây)
        const currentMovie = await fetchMovieBySlug(slug);

        if (currentMovie) {
          addToGlobalMoviesList([currentMovie]);

          // Cập nhật lại giao diện bằng data chuẩn từ DB (phòng khi URL
          // param bị thiếu hoặc cũ hơn dữ liệu thật)
          document.getElementById("detail-title").innerText =
            currentMovie.title;
          document.getElementById("detail-poster-img").src =
            currentMovie.poster;
          document.getElementById("detail-desc").innerText =
            currentMovie.desc || "";
          episodes = currentMovie.episodes || episodes;
          document.getElementById("detail-episodes-count").innerText =
            `${episodes} Tập`;
          fdRenderEpisodeGrid(episodes);
        }

        fdRenderBreadcrumb(currentMovie ? currentMovie.genres : "");

        // 1. Phần phim (nếu cùng series) - fetch riêng theo movie_group
        if (currentMovie && currentMovie.group) {
          const parts = await fetchMovies({
            group: currentMovie.group,
            limit: 10,
          });
          addToGlobalMoviesList(parts);
          renderMovieParts(currentMovie.slug, currentMovie.group);
        }

        // 2. Gợi ý phim cùng thể loại ở sidebar - fetch theo thể loại đầu tiên
        if (
          currentMovie &&
          currentMovie.genres &&
          typeof renderRelatedSuggestions === "function"
        ) {
          const firstGenre = currentMovie.genres.split(",")[0].trim();
          const related = await fetchMovies({ genre: firstGenre, limit: 12 });
          addToGlobalMoviesList(related);
          renderRelatedSuggestions(slug, currentMovie.genres);
        }

        // 3. Kích hoạt gọi API TMDB (nếu hàm đã được định nghĩa trong script.js)
        if (title && typeof loadMovieDetailsFromTMDB === "function") {
          await loadMovieDetailsFromTMDB(title);
        }
      });
    </script>
  </body>
</html>
